---
// Komponent nawigacji dla aplikacji
import MenuToggle from "./MenuToggle";

// Pobierz dane użytkownika z Astro.locals (ustawione przez middleware)
const user = Astro.locals.user;
const userEmail = user?.email;
---

<nav class="bg-background border-b">
  <div class="container mx-auto px-4 py-4">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <a href="/" class="text-xl font-bold text-foreground hover:text-primary transition-colors"> PortfelIO </a>
      </div>

      <div class="flex items-center gap-2">
        <MenuToggle userEmail={userEmail} client:load />
      </div>
    </div>
  </div>
</nav>
