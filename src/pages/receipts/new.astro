---
/* src/pages/receipts/new.astro */
import Layout from "@/layouts/Layout.astro";
import type { CategoryDto } from "@/types";
import ReceiptForm from "@/components/receipts/ReceiptForm";

export const prerender = false;

// Pobranie kategorii z API
let categories: CategoryDto[] = [];
let error: string | null = null;

try {
  const supabase = Astro.locals.supabase;

  if (!supabase) {
    throw new Error("Supabase client not available");
  }

  const { data, error: fetchError } = await supabase.from("categories").select("*").order("order", { ascending: true });

  if (fetchError) {
    console.error("Error fetching categories:", fetchError);
    error = "Nie udało się pobrać kategorii. Odśwież stronę.";
  } else {
    categories = data as CategoryDto[];
  }
} catch (err) {
  console.error("Unexpected error fetching categories:", err);
  error = "Wystąpił błąd. Odśwież stronę.";
}
---

<Layout title="Dodaj Paragon">
  <main class="container mx-auto px-4 py-8 max-w-4xl">
    <h1 class="text-3xl font-bold mb-6">Dodaj Paragon</h1>

    {
      error ? (
        <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-lg">
          <p class="font-medium">Błąd ładowania</p>
          <p class="text-sm">{error}</p>
        </div>
      ) : (
        <ReceiptForm categories={categories} client:load />
      )
    }
  </main>
</Layout>
