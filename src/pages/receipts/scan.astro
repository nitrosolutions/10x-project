---
/* src/pages/receipts/scan.astro */
import Layout from "@/layouts/Layout.astro";
import ReceiptScanner from "@/components/receipts/ReceiptScanner";

export const prerender = false;

// Wykrywanie czy użytkownik ma dostęp do aparatu (na podstawie user-agent)
// Na serwerze nie możemy wykryć aparatu, więc zakładamy że urządzenia mobilne go mają
const userAgent = Astro.request.headers.get("user-agent") || "";
const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(userAgent);
---

<Layout title="Skanuj paragon">
  <main class="container mx-auto px-4 py-8 max-w-4xl">
    <div class="mb-6">
      <h1 class="text-3xl font-bold">Skanuj paragon</h1>
      <p class="text-muted-foreground mt-2">Zrób zdjęcie paragonu lub wybierz plik z galerii</p>
    </div>

    <ReceiptScanner hasCamera={isMobile} client:load />
  </main>
</Layout>
