---
import AuthLayout from "@/layouts/AuthLayout.astro";
import UpdatePasswordForm from "@/components/auth/UpdatePasswordForm";

// Dynamic rendering to allow middleware to check authentication
export const prerender = false;

// Strona dostępna z linku w mailu resetującym
// Supabase przekazuje token recovery przez parametr "code" w URL
// Musimy wymienić ten kod na sesję użytkownika

const code = Astro.url.searchParams.get("code");

// Jeśli nie ma code w URL, może użytkownik wszedł bezpośrednio
// lub token był już wymieniony (refresh strony)
if (code) {
  // Exchange code for session
  const { error } = await Astro.locals.supabase.auth.exchangeCodeForSession(code);

  if (error) {
    console.error("Error exchanging code for session:", error);
    // Token może być nieważny lub wygasły - przekieruj do reset-password
    return Astro.redirect("/reset-password?error=invalid_token");
  }

  // Sukces - przekieruj bez code w URL (clean URL)
  return Astro.redirect("/update-password");
}

// Sprawdź czy użytkownik ma aktywną sesję (po wymianie kodu)
const {
  data: { user },
} = await Astro.locals.supabase.auth.getUser();

if (!user) {
  // Brak sesji - użytkownik musi najpierw zresetować hasło
  return Astro.redirect("/reset-password?error=session_required");
}
---

<AuthLayout title="Aktualizacja hasła - PortfelIO">
  <UpdatePasswordForm client:load />
</AuthLayout>
